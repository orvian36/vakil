# Public app config
NEXT_PUBLIC_APP_NAME="Vakil"
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# External auth service (Makebell platform). The middleware verifies/refreshes
# tokens against this host. For a self-hosted demo you will need to stub or
# replace the middleware in middleware.js.
NEXT_PUBLIC_SUPABASE_URL=https://platform.makebell.com

# SQLite via Prisma. For production switch to libSQL/Postgres and update DATABASE_URL.
DATABASE_URL=file:./prisma/dev.db

# DigitalOcean Spaces (S3-compatible object store)
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=your-bucket-name

# Mistral OCR (https://console.mistral.ai/)
MISTRAL_API_KEY=your-mistral-api-key

# Optional: Gemini (only needed if you bypass the Makebell LLM proxy in lib/llm)
GEMINI_API_KEY=your-gemini-api-key
